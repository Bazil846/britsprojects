---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const {
  title = 'Build with Confidence. Move Forward with Peace of Mind.',
  text = 'Whether you need a specialist team to build your structure or experienced professionals to oversee your appointed builder, Brits Construction Projects Ltd is here to help. Send us your drawings or arrange a discussion about your project.',
  primary = { href: '/contact', label: 'Request a Quotation' },
  secondary = { href: '/contact?topic=site-visit', label: 'Arrange a Site Visit' },
} = Astro.props;
---

<section class="section section--navy cta" aria-labelledby="cta-heading">
  <svg class="cta__lines" viewBox="0 0 600 300" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M90 230 300 70l210 160"></path>
      <path d="M150 238h300M150 262h300M296 238v24"></path>
      <path d="M170 262v38M430 262v38"></path>
    </g>
  </svg>
  <div class="container cta__inner">
    <div>
      <p class="eyebrow">Next step</p>
      <h2 id="cta-heading" class="h2">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={primary.href}>
        {primary.label}
        <span class="btn__chip"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="btn btn--outline" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }
  .cta__lines {
    position: absolute;
    right: -2rem;
    top: 0;
    height: 100%;
    width: min(60%, 640px);
    color: rgba(229, 154, 99, 0.16);
  }
  .cta__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1.4fr auto;
    }
  }
  .cta h2 {
    margin-top: 1rem;
    max-width: 34rem;
  }
  .cta .lead {
    margin-top: 1.25rem;
    color: #c9d5dc;
    max-width: 40rem;
  }
</style>
