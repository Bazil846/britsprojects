---
// Brits Construction Projects logo: a house frame (roof, walls and foundation slab) carrying a
// steel I-beam section, in steel navy and copper: the company's focus on structure.
// Wordmark: serif "BRITS" with "CONSTRUCTION PROJECTS" set to exactly the same width.
interface Props {
  tone?: 'default' | 'onDark';
  class?: string;
  /** Mark only, no wordmark. */
  markOnly?: boolean;
}
const { tone = 'default', class: className = '', markOnly = false } = Astro.props;
const navy = tone === 'onDark' ? '#ffffff' : '#0d2f45';
const copper = tone === 'onDark' ? '#e59a63' : '#b0531c';
const sub = tone === 'onDark' ? 'rgba(255,255,255,0.82)' : '#3d4a52';
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 120 112" aria-hidden="true" focusable="false">
    <!-- roof -->
    <path fill={navy} d="M4 57 60 13l56 44-6.4 7.6L60 25.6 10.4 64.6Z"></path>
    <!-- walls -->
    <path fill={navy} d="M19 53.5h9.5V98H19zM91.5 53.5H101V98h-9.5z"></path>
    <!-- foundation slab -->
    <path fill={navy} d="M10 98h100v9H10z"></path>
    <!-- steel I-beam section -->
    <path fill={copper} d="M40 51h40v8.5H40zM55.5 59.5h9v23h-9zM40 82.5h40V91H40z"></path>
  </svg>
  {
    !markOnly && (
      <svg class="logo__words" viewBox="0 0 300 88" role="img" aria-label="Brits Construction Projects">
        <text
          x="0"
          y="56"
          textLength="300"
          lengthAdjust="spacingAndGlyphs"
          font-family="Cormorant Garamond, Georgia, serif"
          font-size="74"
          font-weight="600"
          letter-spacing="6"
          fill={navy}
        >
          BRITS
        </text>
        <text
          x="1"
          y="84"
          textLength="297"
          lengthAdjust="spacing"
          font-family="Manrope Variable, Manrope, sans-serif"
          font-size="17"
          font-weight="700"
          fill={sub}
        >
          CONSTRUCTION PROJECTS
        </text>
      </svg>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
  }
  .logo__mark {
    width: 3.4rem;
    height: auto;
    flex: none;
  }
  .logo__words {
    display: block;
    height: 2.6rem;
    width: auto;
    flex: none;
    overflow: visible;
  }
  @media (max-width: 420px) {
    .logo__mark {
      width: 3rem;
    }
    .logo__words {
      height: 2.25rem;
    }
  }
</style>
