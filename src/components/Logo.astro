const BEAM = 'M647 846h72v10h-16a7 7 0 0 0-7 7v210a7 7 0 0 0 7 7h16v10h-72v-10h16a7 7 0 0 0 7-7V863a7 7 0 0 0-7-7h-16Z';
---

<span class:list={['logo', className]}>
  {
    markOnly ? (
      <svg class="logo__mark" viewBox="0 0 120 100" aria-hidden="true" focusable="false">
        <path d="M7 47 60 10l53 37" fill="none" stroke={navy} stroke-width="10.5" />
        <path fill={amber} d="M27 53h66v9.5H65v19h28V91H27v-9.5h28v-19H27Z" />
      </svg>
    ) : (
      <svg class="logo__words" viewBox="236 830 871 276" role="img" aria-label="Brits Construction Projects">
        <g transform="translate(74 251.7) scale(0.7)">
          <path fill={navy} d={LETTERS} />
          <path fill={amber} d={BEAM} />
        </g>
        <text
          x="242"
          y="1095"
          textLength="858"
          lengthAdjust="spacing"
          font-family="Manrope Variable, Manrope, sans-serif"
          font-size="52"
          font-weight="700"
          fill={sub}
        >
          CONSTRUCTION PROJECTS
        </text>
      </svg>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .logo__mark {
    width: 3.35rem;
    height: auto;
    flex: none;
  }
  .logo__words {
    display: block;
    height: 3.15rem;
    width: auto;
    flex: none;
  }
  @media (max-width: 420px) {
    .logo__words {
      height: 2.55rem;
    }
  }
</style>
