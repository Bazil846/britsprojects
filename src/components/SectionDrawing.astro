---
// Hero illustration: a simplified structural section through a single-storey extension,
// drawn like a construction drawing (the brand's visual signature in place of stock photos).
// Callouts name the parts of the structure Brits Construction Projects builds.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const callouts = [
  { n: '01', label: 'Roof structure', x: 470, y: 120, tx: 330, ty: 150 },
  { n: '02', label: 'Steel beam', x: 470, y: 212, tx: 300, ty: 231 },
  { n: '03', label: 'Load-bearing masonry', x: 470, y: 300, tx: 378, ty: 320 },
  { n: '04', label: 'Beam & block floor', x: 470, y: 384, tx: 300, ty: 404 },
  { n: '05', label: 'Concrete foundations', x: 470, y: 468, tx: 384, ty: 474 },
];
---

<figure class:list={['drawing', className]}>
  <svg viewBox="0 0 700 540" role="img" aria-labelledby="drawing-title drawing-desc">
    <title id="drawing-title">Structural section through a house extension</title>
    <desc id="drawing-desc">
      A construction drawing showing the roof structure, a steel beam, load-bearing masonry walls, a beam and block floor and concrete
      foundations.
    </desc>
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="#2f5d7a" stroke-opacity=".07" stroke-width="1"></path>
      </pattern>
      <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0V8" stroke="#2f5d7a" stroke-opacity=".55" stroke-width="1.2"></path>
      </pattern>
      <pattern id="earth" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="4" r="1.1" fill="#8a7f70" fill-opacity=".45"></circle>
        <circle cx="10" cy="10" r="1.1" fill="#8a7f70" fill-opacity=".45"></circle>
      </pattern>
    </defs>

    <rect width="700" height="540" fill="#fbfaf7"></rect>
    <rect width="700" height="540" fill="url(#grid)"></rect>

    <g fill="none" stroke="#0d2f45" stroke-width="2" stroke-linejoin="round">
      <!-- ground -->
      <rect x="20" y="420" width="420" height="100" fill="url(#earth)" stroke="none"></rect>
      <path d="M20 420H440" stroke-width="1.5"></path>
      <!-- foundations (hatched concrete) -->
      <rect x="60" y="440" width="70" height="46" fill="url(#hatch)"></rect>
      <rect x="330" y="440" width="70" height="46" fill="url(#hatch)"></rect>
      <!-- walls: two leaves with a cavity -->
      <rect x="74" y="200" width="16" height="240" fill="#fff"></rect>
      <rect x="100" y="200" width="16" height="240" fill="#fff"></rect>
      <rect x="344" y="200" width="16" height="240" fill="#fff"></rect>
      <rect x="370" y="200" width="16" height="240" fill="#fff"></rect>
      <!-- beam and block floor -->
      <path d="M116 396H344M116 412H344" stroke-width="1.5"></path>
      <path d="M140 396v16M170 396v16M200 396v16M230 396v16M260 396v16M290 396v16M320 396v16" stroke-width="1.2" stroke-opacity=".7"></path>
      <!-- screed line -->
      <path d="M116 388H344" stroke-dasharray="6 5" stroke-width="1.2"></path>
      <!-- steel beam (I section, in elevation along the opening) -->
      <rect x="116" y="200" width="228" height="10" fill="#b0531c" stroke="#8f4215"></rect>
      <rect x="116" y="226" width="228" height="10" fill="#b0531c" stroke="#8f4215"></rect>
      <rect x="226" y="210" width="8" height="16" fill="#b0531c" stroke="#8f4215"></rect>
      <!-- roof: joists and pitch -->
      <path d="M60 200 230 92 400 200"></path>
      <path d="M74 200 230 104 386 200" stroke-width="1.2" stroke-opacity=".6"></path>
      <path d="M118 172v28M160 145v55M202 118v82M258 118v82M300 145v55M342 172v28" stroke-width="1.2" stroke-opacity=".5"></path>
      <path d="M90 200H370" stroke-width="2.5"></path>
    </g>

    <!-- dimension line -->
    <g stroke="#2f5d7a" stroke-width="1.2" fill="none">
      <path d="M116 520V500M344 520V500M116 510H344"></path>
      <path d="M116 510l8-4v8zM344 510l-8-4v8z" fill="#2f5d7a"></path>
    </g>
    <text x="230" y="502" text-anchor="middle" font-family="Manrope Variable, Manrope, sans-serif" font-size="12" fill="#2f5d7a" font-weight="600">
      CLEAR SPAN TO ENGINEER'S DESIGN
    </text>

    <!-- callouts -->
    {
      callouts.map((c) => (
        <g>
          <path d={`M${c.tx} ${c.ty}L${c.x - 18} ${c.y}H${c.x}`} stroke="#b0531c" stroke-width="1.3" fill="none" />
          <circle cx={c.tx} cy={c.ty} r="4" fill="#b0531c" />
          <rect x={c.x} y={c.y - 15} width="30" height="30" rx="15" fill="#0d2f45" />
          <text x={c.x + 15} y={c.y + 4.5} text-anchor="middle" font-family="Manrope Variable, Manrope, sans-serif" font-size="12" font-weight="700" fill="#fff">
            {c.n}
          </text>
          <text x={c.x + 40} y={c.y + 5} font-family="Manrope Variable, Manrope, sans-serif" font-size="14" font-weight="600" fill="#0b1820">
            {c.label}
          </text>
        </g>
      ))
    }

    <!-- title block -->
    <g font-family="Manrope Variable, Manrope, sans-serif">
      <rect x="470" y="16" width="220" height="48" fill="#fff" stroke="#cbc6bd"></rect>
      <text x="482" y="36" font-size="10" font-weight="700" letter-spacing="1.2" fill="#5f6b72">BRITS CONSTRUCTION PROJECTS</text>
      <text x="482" y="54" font-size="12" font-weight="600" fill="#0b1820">Typical extension section</text>
    </g>
  </svg>
</figure>

<style>
  .drawing {
    margin: 0;
    border-radius: var(--radius-media);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow-overlay);
  }
  .drawing svg {
    width: 100%;
    height: auto;
  }
</style>
