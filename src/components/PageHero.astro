---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumb: string;
}
const { eyebrow, title, lead, crumb } = Astro.props;
---

<section class="phero">
  <div class="container">
    <nav aria-label="Breadcrumb" class="phero__crumbs">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <div class="phero__grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display phero__title">{title}</h1>
        {lead && <p class="lead phero__lead">{lead}</p>}
        <div class="phero__actions"><slot name="actions" /></div>
      </div>
      <div class="phero__aside"><slot name="aside" /></div>
    </div>
  </div>
</section>

<style>
  .phero {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 clamp(3rem, 2.5rem + 3vw, 5rem);
    background: linear-gradient(var(--canvas), var(--stone));
    border-bottom: 1px solid var(--line);
  }
  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .phero__crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line-strong);
  }
  .phero__crumbs a {
    color: var(--muted);
  }
  .phero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 1000px) {
    .phero__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
  }
  .phero__title {
    margin-top: 1.25rem;
    font-size: clamp(2.2rem, 1.3rem + 3vw, 4rem);
  }
  .phero__lead {
    margin-top: 1.5rem;
    max-width: 42rem;
  }
  .phero__actions:not(:empty) {
    margin-top: 2rem;
  }
</style>
