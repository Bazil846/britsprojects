---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCall from '../components/StickyCall.astro';
import { SITE_URL, company } from '../site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), SITE_URL).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${SITE_URL}/#business`,
  name: company.name,
  url: SITE_URL,
  slogan: company.tagline,
  description:
    'Residential structural building work and independent project management for extensions, loft conversions, internal alterations and new homes.',
  logo: `${SITE_URL}/logo.svg`,
  ...(company.phoneHref && { telephone: company.phoneHref }),
  ...(company.email && { email: company.email }),
  address: { '@type': 'PostalAddress', streetAddress: '66 Yeading Avenue', addressLocality: 'Harrow', postalCode: 'HA2 9RN', addressCountry: 'GB' },
  areaServed: [{ '@type': 'City', name: 'London' }, { '@type': 'AdministrativeArea', name: 'Home Counties' }],
  knowsAbout: [
    'Structural building work',
    'Foundations',
    'Structural steelwork',
    'Loft conversions',
    'House extensions',
    'Construction project management',
    'Party wall requirements',
  ],
  parentOrganization: { '@type': 'Organization', name: company.sister.name, url: company.sister.url },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0d2f45" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brits Construction Projects: residential structural work and project management" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCall />
  </body>
</html>
