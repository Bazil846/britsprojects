---
import { photo } from '../lib/photo';
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { structuralCore, structuralTrades, structuralFaqs, projectTypes } from '../content';
import { SITE_URL, company } from '../site';

const designers = [
  { icon: 'drawing', title: 'Your architect’s drawings', text: 'We build to the approved drawings and raise anything unclear or inconsistent before work starts.' },
  { icon: 'steel', title: 'Your engineer’s design', text: 'Foundations, beams, columns and connections follow the structural engineer’s design and calculations.' },
  { icon: 'shield', title: 'Building Control', text: 'We plan around inspections so each stage is ready to be seen before it is covered up.' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Residential and commercial structural building work',
    serviceType: 'Structural building work',
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: 'London and the Home Counties',
    url: `${SITE_URL}/structural-works`,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Structural works',
      itemListElement: [...structuralCore, ...structuralTrades].map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, description: s.text },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Structural works', item: `${SITE_URL}/structural-works` },
    ],
  },
];
---

<Base
  title="Structural Building Work | Brits Construction Projects"
  description="Structural packages for extensions, lofts, alterations, new builds and commercial buildings: foundations, drainage, masonry, steelwork, floors and roof structures."
  schema={schema}
>
  <PhotoHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Structural works' }]}
    image="/photos/stock-rebar-pour.webp"
    alt="Concrete being pumped over steel reinforcement for a foundation slab"
    position="50% 50%"
    pill="Structural work specialists"
    title="Strong Foundations"
    accent="for Homes and Businesses"
    lead="The strength of any building depends on the work beneath the surface. Foundations, steel connections, supporting walls and roof structures all deserve careful attention."
    caption="Concrete pour over reinforcement"
  >
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#enquire">
        Request a structural quotation
        <span class="btn__chip"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="btn btn--outline" href="/contact#drawings"><Icon name="drawing" size={20} /> Send your drawings</a>
    </div>
  </PhotoHero>

  <nav class="subnav" aria-label="On this page">
    <div class="container">
      <ul>
        <li><a href="#projects-heading">Project types</a></li>
        <li><a href="#trades-heading">What we build</a></li>
        <li><a href="#design-heading">Working to your design</a></li>
        <li><a href="#sw-faq-heading">Questions</a></li>
      </ul>
    </div>
  </nav>

  <section class="section" aria-labelledby="projects-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">Project types</p>
          <h2 id="projects-heading" class="h2">Structural packages for homes and commercial buildings</h2>
          <p class="lead">
            We undertake structural building packages for residential extensions, loft conversions, internal alterations and new builds, and for commercial projects,
            working to the architectural drawings, structural engineer’s design and agreed specifications.
          </p>
        </div>
      </div>
      <div class="ptypes">
        {
          structuralCore.map((s) => {
            const p = projectTypes.find((t) => t.id === s.id)!;
            return (
              <a class="ptype" id={s.id} href={`/structural-works/${s.id}`}>
                <span class="ptype__media">
                  <img {...photo(p.hero, '(min-width: 800px) 620px, 100vw')} alt={p.heroAlt} loading="lazy" decoding="async" style={`object-position:${p.heroPosition}`} />
                </span>
                <span class="ptype__body">
                  <span class="ptype__pill">{p.pill}</span>
                  <span class="ptype__title">{s.title}</span>
                  <span class="ptype__text">{s.text}</span>
                  <span class="ptype__more">
                    Explore {p.nav.toLowerCase()} <Icon name="arrow" size={18} />
                  </span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="trades-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">What we build</p>
          <h2 id="trades-heading" class="h2">From the ground up</h2>
          <p class="lead">Every stage of the structure, carried out by one team to the engineer’s design.</p>
        </div>
      </div>
      <ol class="trades">
        {
          structuralTrades.map((t, i) => (
            <li id={t.id}>
              <img class="trades__img" {...photo(t.photo, '(min-width: 1050px) 410px, (min-width: 700px) 50vw, 100vw')} alt={t.alt} loading="lazy" decoding="async" />
              <span class="trades__n tabular">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={t.icon} size={26} class="trades__icon" />
              <h3 class="h3">{t.title}</h3>
              <p>{t.text}</p>
              {'credit' in t && (
                <p class="trades__credit">
                  <a href={t.credit.url} rel="noopener">{t.credit.text}</a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="design-heading">
    <div class="container design">
      <div class="design__media">
        <img {...photo('/photos/stock-plan-level.webp', '(min-width: 1000px) 480px, 100vw')} alt="Hard hat and spirit level resting on a set of construction drawings" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="eyebrow">Working to your design</p>
        <h2 id="design-heading" class="h2">Built exactly as your designers intended</h2>
        <p class="lead">
          The structure is where shortcuts cost the most. We follow the design, plan around inspections and speak up early if something on
          site does not match.
        </p>
        <ul class="design__list">
          {
            designers.map((d) => (
              <li>
                <span class="design__icon">
                  <Icon name={d.icon} size={24} />
                </span>
                <div>
                  <h3 class="h3">{d.title}</h3>
                  <p>{d.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="pm-link">
          <div>
            <p class="pm-link__k">Already have a builder?</p>
            <p>
              {company.shortName} can oversee their work instead, checking it against the drawings and reviewing progress before you pay.
            </p>
          </div>
          <a class="btn btn--outline" href="/project-management">Project management</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews ids={['piling', 'shell', 'newbuild']} title="Solidly built, by the Brits team" tone="stone" />

  <Faq id="sw-faq-heading" title="Structural works questions" items={structuralFaqs} />

  <EnquiryBand
    title="Request a structural works quotation"
    text="Send us your architectural drawings and structural engineer’s design, and we will prepare a clear scope and quotation for the structural package."
    topic="Structural works"
    formId="sw-enquiry"
  />
</Base>

<style>
  .ptypes {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .ptypes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ptype {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-media);
    text-decoration: none;
    color: var(--body);
    scroll-margin-top: 9rem;
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .ptype:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-overlay);
  }
  @media (min-width: 800px) {
    .ptypes > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .ptypes > :last-child:nth-child(odd) .ptype__media {
      flex: 0 0 50%;
      aspect-ratio: auto;
      min-height: 20rem;
    }
  }
  .ptype__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .ptype__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .ptype:hover .ptype__media img {
    transform: scale(1.03);
  }
  .ptype__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
  }
  .ptype__pill {
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--steel-tint);
    color: var(--steel);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .ptype__title {
    color: var(--ink);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .ptype__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--copper);
    font-weight: 700;
  }
  .ptype__more :global(svg) {
    transition: transform 0.2s;
  }
  .ptype:hover .ptype__more :global(svg) {
    transform: translateX(3px);
  }
  .trades {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .trades {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1050px) {
    .trades {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .trades li {
    overflow: hidden;
    position: relative;
    padding: 1.75rem;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    scroll-margin-top: 9rem;
  }
  .trades__img {
    display: block;
    width: calc(100% + 3.5rem);
    max-width: none;
    margin: -1.75rem -1.75rem 1.25rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .trades__n {
    position: absolute;
    z-index: 1;
    top: 1rem;
    right: 1rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(8, 32, 47, 0.8);
    font-weight: 700;
    font-size: 0.85rem;
    color: #fff;
  }
  .trades :global(.trades__icon) {
    color: var(--copper);
  }
  .trades h3 {
    margin-top: 1rem;
  }
  .trades p {
    margin-top: 0.5rem;
  }
  .trades__credit {
    font-size: 0.75rem;
  }
  .trades__credit a {
    color: var(--muted);
  }
  .design {
    display: grid;
    gap: 3rem;
  }
  .design > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .design {
      grid-template-columns: 5fr 7fr;
      gap: 4.5rem;
      align-items: start;
    }
  }
  .design__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }
  @media (max-width: 999px) {
    .design__media img {
      aspect-ratio: 4 / 3;
      object-position: 50% 35%;
    }
  }
  .design h2 {
    margin-top: 1rem;
  }
  .design .lead {
    margin-top: 1.25rem;
  }
  .design__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .design__list li {
    display: flex;
    gap: 1.1rem;
  }
  .design__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--navy);
    color: #fff;
  }
  .design__list p {
    margin-top: 0.35rem;
  }
  .pm-link {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card);
    background: var(--steel-tint);
  }
  @media (min-width: 700px) {
    .pm-link {
      grid-template-columns: 1fr auto;
    }
  }
  .pm-link__k {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.1rem;
  }
</style>
