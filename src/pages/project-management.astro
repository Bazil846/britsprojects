---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import Comparison from '../components/Comparison.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { oversight, oversightNote, oversightFaqs } from '../content';
import { SITE_URL } from '../site';

const timing = [
  {
    when: 'Before work starts',
    title: 'Set the project up well',
    text: 'We review the drawings, the engineer’s design, your builder’s programme and payment schedule, and agree the stages we will check.',
  },
  {
    when: 'During the build',
    title: 'Stage by stage reviews',
    text: 'We visit at the key structural stages and before each payment, raise concerns with your builder and keep you updated.',
  },
  {
    when: 'Already under way',
    title: 'Step in at any point',
    text: 'We review the work that can still be seen, check it against the drawings and set up reviews for the rest of the build.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Construction project management and independent site oversight',
    serviceType: 'Construction project management',
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: 'London and the Home Counties',
    url: `${SITE_URL}/project-management`,
    description:
      'Independent oversight of your appointed builder: work checked against the drawings, planning and party wall requirements monitored, progress reviewed before stage payments, and the professional team coordinated.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Project management', item: `${SITE_URL}/project-management` },
    ],
  },
];
---

<Base
  title="Project Management & Site Oversight | Brits Projects"
  description="Already appointed a builder or contractor? Independent oversight for residential and commercial projects: work checked against the drawings and progress reviewed before you pay."
  schema={schema}
>
  <PhotoHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Project management' }]}
    image="/photos/stock-site-review.webp"
    alt="Two site engineers in hard hats reviewing construction drawings on site"
    position="50% 40%"
    pill="Project management & independent site oversight"
    title="Your Builder. Our Oversight."
    accent="Your Peace of Mind."
    lead="Already appointed a builder or contractor? Have an experienced construction team looking after your interests on residential and commercial projects, from the first trench to the final inspection."
    caption="Reviewing the drawings on site"
  >
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#enquire">
        Book a project review
        <span class="btn__chip"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="btn btn--outline" href="/contact?topic=project-management">Discuss project management</a>
    </div>
  </PhotoHero>

  <nav class="subnav" aria-label="On this page">
    <div class="container">
      <ul>
        <li><a href="#what-heading">What we do</a></li>
        <li><a href="#when-heading">When to bring us in</a></li>
        <li><a href="#cmp-heading">Why have oversight</a></li>
        <li><a href="#pm-faq-heading">Questions</a></li>
      </ul>
    </div>
  </nav>

  <section class="section" aria-labelledby="intro-heading">
    <div class="container intro">
      <div>
        <p class="eyebrow">On your side</p>
        <h2 id="intro-heading" class="h2">We ask the technical questions, so you can make informed decisions</h2>
      </div>
      <div>
        <p class="lead">
          At Brits Construction Projects Ltd, we can manage and monitor your project on your behalf. We ask the technical questions, review key
          stages and raise concerns with your builder, helping you make informed decisions throughout the build.
        </p>
        <p class="intro__quote">
          Building your dream home or a commercial property is a major investment. You deserve to understand how the work is progressing, whether the structure
          follows the design and whether each payment reflects the work completed.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="what-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">What we do</p>
          <h2 id="what-heading" class="h2">How we look after your interests</h2>
        </div>
      </div>
      <ol class="ov">
        {
          oversight.map((o, i) => (
            <li id={o.id}>
              <div class="ov__head">
                <span class="ov__icon">
                  <Icon name={o.icon} size={26} />
                </span>
                <span class="ov__n tabular">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="h3">{o.title}</h3>
              {o.text.map((t) => (
                <p>{t}</p>
              ))}
            </li>
          ))
        }
      </ol>
      <p class="note">
        <Icon name="shield" size={22} />
        <span>{oversightNote}</span>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="when-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">Timing</p>
          <h2 id="when-heading" class="h2">When to bring us in</h2>
          <p class="lead">The earlier we are involved, the more we can check. But it is never too late to have someone on your side.</p>
        </div>
      </div>
      <ol class="when">
        {
          timing.map((t, i) => (
            <li>
              <span class="when__n tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p class="when__k">{t.when}</p>
              <h3 class="h3">{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Comparison quote={false} />

  <Reviews ids={['pm-onsite', 'pm-planning', 'pm-schedule']} title="Well managed, start to finish" />

  <Faq id="pm-faq-heading" tone="stone" title="Project management questions" items={oversightFaqs} />

  <EnquiryBand
    title="Book a project review"
    text="Tell us about your project and your builder. We will talk through the stages you would like reviewed and how our oversight would work alongside your team."
    topic="Project review"
    formId="pm-enquiry"
  />
</Base>

<style>
  .subnav {
    position: sticky;
    top: 4.75rem;
    z-index: 30;
    margin-top: 1.25rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .subnav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav a {
    display: block;
    white-space: nowrap;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.925rem;
    text-decoration: none;
  }
  .subnav a:hover {
    background: var(--stone);
  }
  .intro h2 {
    margin-top: 1rem;
  }
  .intro__quote {
    margin-top: 1.75rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--amber);
    color: var(--ink);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .when {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .when {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .when li {
    position: relative;
    padding: 2rem 1.75rem 1.75rem;
    border-radius: var(--radius-card);
    background: var(--navy);
    color: #d5dfe5;
  }
  .when__n {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    color: var(--copper-light);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }
  .when__k {
    color: var(--copper-light);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .when h3 {
    margin: 0.75rem 0 0.5rem;
    color: #fff;
  }
  .intro {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1000px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
    }
  }
  .ov {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .ov {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .ov {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Seven cards: the last spans the row instead of sitting alone. */
  @media (min-width: 760px) {
    .ov li:last-child {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1.5rem;
      align-items: start;
    }
    .ov li:last-child .ov__head {
      grid-row: span 2;
    }
    .ov li:last-child .ov__n {
      display: none;
    }
  }
  .ov li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    scroll-margin-top: 9rem;
  }
  .ov__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }
  .ov__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--copper-tint);
    color: var(--copper-dark);
  }
  .ov__n {
    font-weight: 700;
    color: var(--copper);
  }
  .note {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--steel-tint);
    color: var(--ink);
    font-size: 0.975rem;
  }
  .note :global(svg) {
    flex: none;
    color: var(--steel);
    margin-top: 0.1rem;
  }
</style>
