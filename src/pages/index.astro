---
import { photo } from '../lib/photo';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhotoHero from '../components/PhotoHero.astro';
import BuildStrip from '../components/BuildStrip.astro';
import Comparison from '../components/Comparison.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import Faq from '../components/Faq.astro';
import Logo from '../components/Logo.astro';
import Reviews from '../components/Reviews.astro';
import { projectTypes, structuralTrades, oversight, accreditations, structuralFaqs, oversightFaqs } from '../content';
import { SITE_URL, company } from '../site';

const promises = [
  { icon: 'shield', title: 'Sound construction', text: 'Built to the engineer’s design' },
  { icon: 'cost', title: 'Controlled costs', text: 'Payments matched to progress' },
  { icon: 'programme', title: 'Reliable progress', text: 'Programme monitored stage by stage' },
  { icon: 'check', title: 'Quality workmanship', text: 'Checked before it is covered up' },
] as const;

const steps = [
  { title: 'Send your drawings', text: 'Share your architectural drawings, structural engineer’s design and specification, or tell us where your project is up to.' },
  { title: 'We review and advise', text: 'We study the design and talk through what you need: structural works, project management, or both.' },
  { title: 'Clear written scope', text: 'You receive a quotation that sets out exactly what is included, or a plan of the stages we will review.' },
  { title: 'Build and oversight', text: 'From the first excavation to the final structural inspection, with clear updates at every stage.' },
];

const assurances = [
  { icon: 'drawingsCheck', title: 'Built to the design', text: 'We work to your architect’s drawings and structural engineer’s design, and raise anything that does not match before work goes further.' },
  { icon: 'shield', title: 'Inspections planned in', text: 'Foundations, drainage and steelwork are ready for Building Control before anything is covered up.' },
  { icon: 'team', title: 'A professional team', text: 'Architects, structural engineers and party wall surveyors on hand when your project needs them.' },
  { icon: 'home', title: 'Part of the Brits group', text: 'The sister company of Brits Construction Services, accredited and insured.' },
] as const;

const faqs = [structuralFaqs[0], structuralFaqs[1], oversightFaqs[0], oversightFaqs[1], oversightFaqs[2], structuralFaqs[4]];

const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: company.name, url: SITE_URL }];
---

<Base
  title="Structural Work & Project Management | Brits Projects"
  description="Structural building work and independent project management for residential and commercial projects in London and the Home Counties."
  schema={schema}
>
  <PhotoHero
    size="home"
    image="/photos/stock-roof-structure.webp"
    alt="New timber roof structure being framed on top of a building"
    position="50% 45%"
    pill="Residential & commercial · London and the Home Counties"
    title="A Stronger Home."
    accent="A Better Managed Build."
    lead="We build the structure your building depends on, or oversee your builder on your behalf. Structural works and project management for homes and commercial premises: extensions, loft conversions, alterations, new builds and commercial projects."
    caption="A new roof structure going on"
  >
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#offerings">
        Explore our two services
        <span class="btn__chip"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="btn btn--outline" href={`tel:${company.phoneHref}`}><Icon name="phone" size={20} /> {company.phone}</a>
    </div>
  </PhotoHero>

  <!-- The two offerings: the heart of the site -->
  <section class="offers" id="offerings" aria-labelledby="offers-heading">
    <div class="container">
      <div class="offers__head">
        <p class="eyebrow">Two ways we help</p>
        <h2 id="offers-heading" class="h2">Structural works. Project management. <span>Or both.</span></h2>
      </div>
      <div class="offers__grid">
        <article class="offer">
          <a class="offer__media" href="/structural-works" tabindex="-1" aria-hidden="true">
            <img {...photo('/photos/stock-rebar-grid.webp', '(min-width: 960px) 620px, 100vw')} alt="" loading="lazy" decoding="async" />
            <span class="offer__num">01</span>
          </a>
          <div class="offer__body">
            <p class="offer__kicker"><Icon name="steel" size={20} /> Structural Works</p>
            <h3 class="offer__title">We build the structure</h3>
            <p>
              Foundations, drainage, walls, floors, steelwork and roof structures for extensions, loft conversions, internal alterations, new
              builds and commercial buildings, built to your engineer’s design.
            </p>
            <p class="offer__for"><strong>Best for:</strong> you have drawings and need a builder for the structural package.</p>
            <ul class="offer__links">
              {
                projectTypes.map((p) => (
                  <li>
                    <a href={`/structural-works/${p.id}`}>
                      {p.nav}
                      <Icon name="arrow" size={18} />
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="btn-row">
              <a class="btn btn--primary" href="/structural-works">
                Structural works
                <span class="btn__chip"><Icon name="arrow" size={18} /></span>
              </a>
              <a class="btn btn--outline" href="/contact?topic=structural">Request a quotation</a>
            </div>
          </div>
        </article>

        <article class="offer offer--pm">
          <a class="offer__media" href="/project-management" tabindex="-1" aria-hidden="true">
            <img {...photo('/photos/stock-plans-review.webp', '(min-width: 960px) 620px, 100vw')} alt="" loading="lazy" decoding="async" />
            <span class="offer__num">02</span>
          </a>
          <div class="offer__body">
            <p class="offer__kicker"><Icon name="drawingsCheck" size={20} /> Project Management</p>
            <h3 class="offer__title">We oversee your builder</h3>
            <p>
              Already appointed a builder? We check the work against the drawings, review progress before you pay and coordinate your
              professional team, so someone experienced is on your side.
            </p>
            <p class="offer__for"><strong>Best for:</strong> you have a builder and want independent eyes on the work.</p>
            <ul class="offer__links">
              {
                oversight.slice(0, 4).map((o) => (
                  <li>
                    <a href={`/project-management#${o.id}`}>
                      {o.title.replace(/^We /, '')}
                      <Icon name="arrow" size={18} />
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="btn-row">
              <a class="btn btn--primary" href="/project-management">
                Project management
                <span class="btn__chip"><Icon name="arrow" size={18} /></span>
              </a>
              <a class="btn btn--outline" href="/contact?topic=project-review">Book a project review</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Proof band -->
  <section class="proof" aria-label="Our promises and accreditations">
    <div class="container">
      <ul class="proof__promises">
        {
          promises.map((p) => (
            <li>
              <Icon name={p.icon} size={26} />
              <div>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="proof__acc">
        <p class="eyebrow">Accredited &amp; insured</p>
        <ul>
          {
            accreditations.map((a) => (
              <li>
                <img src={a.src} alt={`${a.name} logo`} loading="lazy" decoding="async" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Offering 1 in depth -->
  <section class="section section--stone deep" aria-labelledby="sw-heading">
    <div class="container deep__grid">
      <div class="deep__media">
        <img class="deep__main" {...photo('/photos/stock-roof-framing.webp', '(min-width: 1000px) 480px, 100vw')} alt="Builders framing a new timber roof on a blockwork building" loading="lazy" decoding="async" />
        <img class="deep__inset" {...photo('/photos/groundworks-1.webp', '240px')} alt="Foundation trench with steel reinforcement and formwork" loading="lazy" decoding="async" />
      </div>
      <div class="deep__text">
        <p class="eyebrow">01 · Structural works</p>
        <h2 id="sw-heading" class="h2">Strong foundations for homes and businesses</h2>
        <p class="lead">
          The strength of any building depends on the work beneath the surface. We undertake structural packages for residential and commercial projects,
          working to the architectural drawings, structural engineer’s design and agreed specification.
        </p>
        <ul class="types">
          {
            projectTypes.map((p) => (
              <li>
                <a href={`/structural-works/${p.id}`}>
                  <img {...photo(p.hero, '72px')} alt="" loading="lazy" decoding="async" />
                  <span>
                    <strong>{p.nav}</strong>
                    <small>{p.pill}</small>
                  </span>
                  <Icon name="arrow" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="deep__label">One team for every structural trade</p>
        <ul class="chips">
          {
            structuralTrades.map((t) => (
              <li>
                <a href={`/structural-works#${t.id}`}>
                  <Icon name={t.icon} size={18} />
                  {t.title}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="btn-row deep__cta">
          <a class="btn btn--primary" href="/contact?topic=structural">
            Request a structural quotation
            <span class="btn__chip"><Icon name="arrow" size={18} /></span>
          </a>
          <a class="btn btn--outline" href="/contact#drawings"><Icon name="drawing" size={20} /> Send your drawings</a>
        </div>
      </div>
    </div>
  </section>

  <BuildStrip />

  <!-- Offering 2 in depth -->
  <section class="section deep deep--pm" aria-labelledby="pm-heading">
    <div class="container">
      <div class="pm__head">
        <div>
          <p class="eyebrow">02 · Project management</p>
          <h2 id="pm-heading" class="h2">Your builder. Our oversight. Your peace of mind.</h2>
        </div>
        <p class="lead">
          Building or altering a property is a major investment. We ask the technical questions, review key stages and raise concerns with your builder,
          so you can make informed decisions throughout the build.
        </p>
      </div>
      <ol class="pm__list">
        {
          oversight.map((o, i) => (
            <li>
              <a class="pm__card" href={`/project-management#${o.id}`}>
                <span class="pm__n tabular">{String(i + 1).padStart(2, '0')}</span>
                <span class="pm__icon">
                  <Icon name={o.icon} size={24} />
                </span>
                <span class="pm__title">{o.title}</span>
                <span class="pm__text">{o.text[0]}</span>
              </a>
            </li>
          ))
        }
        <li class="pm__cta">
          <p>Already appointed a builder, or work already under way?</p>
          <a class="btn btn--primary" href="/contact?topic=project-review">
            Book a project review
            <span class="btn__chip"><Icon name="arrow" size={18} /></span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <Comparison />

  <!-- Process -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="eyebrow">How it works</p>
          <h2 id="process-heading" class="h2">A clear process from the first drawing</h2>
          <p class="lead">Whether we are building the structure or overseeing your builder, here is what to expect.</p>
        </div>
        <a class="link-arrow" href="/about">Why choose us <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class:list={[i === 0 && 'is-first']}>
              <span class="steps__n tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Reviews tone="stone" />

  <!-- Assurance panel -->
  <section class="assure-wrap" aria-labelledby="assure-heading">
    <div class="container">
      <div class="assure">
        <div class="assure__mark" aria-hidden="true"><Logo markOnly tone="onDark" /></div>
        <div class="assure__head">
          <div>
            <p class="eyebrow">Our commitment</p>
            <h2 id="assure-heading" class="h2">Built on the right foundations</h2>
          </div>
          <p class="lead">Sound construction, controlled costs, reliable progress and quality workmanship, at every stage.</p>
        </div>
        <ul class="assure__list">
          {
            assurances.map((a) => (
              <li>
                <span class="assure__icon">
                  <Icon name={a.icon} size={24} />
                </span>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq id="home-faq-heading" title="Common questions" items={faqs} tone="stone" />

  <EnquiryBand
    title="Tell us about your project"
    text="Send us a few details and, if you have them, your drawings. We will come back to you to talk through structural works, project management, or both."
    formId="home-enquiry"
  />
</Base>

<style>
  /* Offerings */
  .offers {
    padding: clamp(4rem, 3rem + 4vw, 6.5rem) 0;
  }
  .offers__head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .offers__head h2 {
    margin-top: 1rem;
  }
  .offers__head h2 span {
    color: var(--copper);
  }
  .offers__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 960px) {
    .offers__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .offer {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-media);
    background: #fff;
  }
  .offer__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .offer__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .offer:hover .offer__media img {
    transform: scale(1.03);
  }
  .offer__num {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    color: #fff;
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    text-shadow: 0 2px 18px rgba(8, 32, 47, 0.5);
  }
  .offer__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .offer__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--copper);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .offer__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .offer__for {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-input);
    background: var(--stone);
    font-size: 0.95rem;
  }
  .offer__for strong {
    color: var(--ink);
  }
  .offer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .offer__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .offer__links a::first-letter {
    text-transform: uppercase;
  }
  .offer__links :global(svg) {
    flex: none;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .offer__links a:hover {
    color: var(--copper);
  }
  .offer__links a:hover :global(svg) {
    transform: translateX(3px);
    color: var(--copper);
  }
  .offer .btn-row {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Proof band */
  .proof {
    padding: 0 0 clamp(3.5rem, 3rem + 2vw, 5rem);
  }
  .proof__promises {
    list-style: none;
    margin: 0;
    padding: 2rem 0;
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 600px) {
    .proof__promises {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .proof__promises {
      grid-template-columns: repeat(4, 1fr);
    }
    .proof__promises li + li {
      border-left: 1px solid var(--line);
      padding-left: 1.5rem;
    }
  }
  .proof__promises li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .proof__promises :global(svg) {
    flex: none;
    color: var(--copper);
  }
  .proof__promises div {
    display: grid;
    line-height: 1.4;
  }
  .proof__promises strong {
    color: var(--ink);
    font-size: 1.1rem;
  }
  .proof__promises span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .proof__acc {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-top: 2rem;
  }
  @media (min-width: 960px) {
    .proof__acc {
      grid-template-columns: 13rem 1fr;
      gap: 2rem;
    }
  }
  .proof__acc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 700px) {
    .proof__acc ul {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .proof__acc li {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.75rem;
    overflow: hidden;
    padding: 0.6rem 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-input);
  }
  .proof__acc img {
    width: 100%;
    height: 100%;
    min-width: 0;
    object-fit: contain;
  }

  /* Structural works in depth */
  .deep__grid {
    display: grid;
    gap: 3rem;
  }
  .deep__grid > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .deep__grid {
      grid-template-columns: 5fr 7fr;
      gap: 4.5rem;
    }
    .deep__media {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .deep__media {
    position: relative;
    padding-bottom: 3rem;
  }
  .deep__main {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }
  @media (max-width: 999px) {
    .deep__main {
      aspect-ratio: 4 / 3;
    }
  }
  .deep__inset {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: 45%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 6px solid var(--stone);
  }
  .deep__text h2 {
    margin-top: 1rem;
  }
  .deep__text .lead {
    margin-top: 1.25rem;
  }
  .types {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .types {
      grid-template-columns: 1fr 1fr;
    }
  }
  .types a {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 0.65rem 1rem 0.65rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: #fff;
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .types a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-overlay);
  }
  @media (min-width: 640px) {
    .types li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .types img {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    object-fit: cover;
    border-radius: 10px;
  }
  .types span {
    display: grid;
    flex: 1;
    line-height: 1.35;
  }
  .types strong {
    color: var(--ink);
    font-size: 1.05rem;
  }
  .types small {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .types :global(svg) {
    flex: none;
    color: var(--copper);
  }
  .deep__label {
    margin-top: 2.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chips {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--ink);
  }
  .chips :global(svg) {
    color: var(--copper);
  }
  .deep__cta {
    margin-top: 2.25rem;
  }

  /* Project management in depth */
  .pm__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  @media (min-width: 1000px) {
    .pm__head {
      grid-template-columns: 1fr 1fr;
      gap: 4.5rem;
      align-items: end;
    }
  }
  .pm__head h2 {
    margin-top: 1rem;
  }
  .pm__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .pm__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .pm__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pm__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--body);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .pm__card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-overlay);
  }
  .pm__n {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-weight: 700;
    color: var(--copper);
  }
  .pm__icon {
