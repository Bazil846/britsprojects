---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found | Brits Construction Projects" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Error 404</p>
      <h1 class="display">This page isn’t here</h1>
      <p class="lead">The page may have moved. These will get you back on track.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Home <span class="btn__chip"><Icon name="arrow" size={18} /></span></a>
        <a class="btn btn--outline" href="/structural-works">Structural works</a>
        <a class="btn btn--outline" href="/project-management">Project management</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 1.25rem; max-width: 46rem; }
  .nf .btn-row { margin-top: 1rem; }
</style>
