---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { FORM_ENDPOINT, SITE_URL, company } from '../site';

const tel = company.phoneHref;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${company.name}`,
    url: `${SITE_URL}/contact`,
    about: { '@id': `${SITE_URL}/#business` },
  },
];
---

<Base
  title="Contact & Send Your Drawings | Brits Construction Projects"
  description="Request a structural works quotation, book a project review or send us your drawings. Tell us about your extension, loft conversion, alteration or new home."
  schema={schema}
>
  <PageHero
    crumb="Contact"
    eyebrow="Contact"
    title="Send us your drawings or arrange a discussion"
    lead="Tell us about your project and how we can help: structural works, project management, or both. We will come back to you to talk it through."
  />

  <section class="section" aria-labelledby="form-heading">
    <div class="container contact">
      <div class="contact__form card">
        <h2 id="form-heading" class="h3">Project enquiry</h2>
        <form id="enquiry" class="form" novalidate data-endpoint={FORM_ENDPOINT} data-email={company.email}>
          <input type="hidden" name="_subject" value={`New enquiry: ${company.shortName} website`} />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <fieldset class="form__choice">
            <legend class="field-label">How can we help? <span aria-hidden="true">*</span></legend>
            <div class="chips">
              <label><input type="radio" name="service" value="Structural works" required /><span>Structural works</span></label>
              <label><input type="radio" name="service" value="Project management" /><span>Project management</span></label>
              <label><input type="radio" name="service" value="Project review" /><span>Project review</span></label>
              <label><input type="radio" name="service" value="Site visit" /><span>Site visit</span></label>
              <label><input type="radio" name="service" value="Not sure yet" /><span>Not sure yet</span></label>
            </div>
          </fieldset>

          <div class="form__row">
            <div>
              <label class="field-label" for="f-name">Your name <span aria-hidden="true">*</span></label>
              <input class="field" id="f-name" name="name" autocomplete="name" required />
            </div>
            <div>
              <label class="field-label" for="f-phone">Phone</label>
              <input class="field" id="f-phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="form__row">
            <div>
              <label class="field-label" for="f-email">Email <span aria-hidden="true">*</span></label>
              <input class="field" id="f-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label class="field-label" for="f-postcode">Project postcode</label>
              <input class="field" id="f-postcode" name="postcode" autocomplete="postal-code" />
            </div>
          </div>
          <div class="form__row">
            <div>
              <label class="field-label" for="f-type">Project type</label>
              <select class="field" id="f-type" name="project_type">
                <option value="">Choose one</option>
                <option>Extension</option>
                <option>Loft conversion</option>
                <option>Internal structural alteration</option>
                <option>New build</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="f-stage">Where is the project up to?</label>
              <select class="field" id="f-stage" name="stage">
                <option value="">Choose one</option>
                <option>Drawings and engineer’s design ready</option>
                <option>Drawings in progress</option>
                <option>Builder appointed, work starting soon</option>
                <option>Work already under way</option>
                <option>Early planning</option>
              </select>
            </div>
          </div>
          <div>
            <label class="field-label" for="f-message">About your project <span aria-hidden="true">*</span></label>
            <textarea class="field" id="f-message" name="message" required placeholder="What are you planning, and what would you like us to do?"></textarea>
          </div>

          <p class="form__error" role="alert" hidden></p>
          <button class="btn btn--primary form__submit" type="submit">
            Send enquiry
            <span class="btn__chip"><Icon name="arrow" size={18} /></span>
          </button>
          <p class="form__small">We use your details only to reply to your enquiry.</p>
        </form>
        <div class="form__done" role="status" hidden tabindex="-1">
          <Icon name="check" size={32} />
          <h3 class="h3">Thank you, your enquiry has been sent</h3>
          <p>We will be in touch to discuss your project. If you have drawings, have them ready to share when we reply.</p>
        </div>
      </div>

      <aside class="contact__side">
        <div class="side-card" id="drawings">
          <Icon name="drawing" size={28} />
          <h2 class="h3">Send us your drawings</h2>
          <p>
            Architectural drawings, the structural engineer’s design and your specification help us give you an accurate scope and quotation,
            or plan our oversight of your builder.
          </p>
          {
            company.email ? (
              <a class="btn btn--outline" href={`mailto:${company.email}?subject=${encodeURIComponent('Drawings for my project')}`}>
                <Icon name="mail" size={20} /> Email your drawings
              </a>
            ) : (
              <p class="side-note">Mention your drawings in the enquiry form and we will reply with the best way to send them.</p>
            )
          }
        </div>
        {
          (company.phone || company.email || company.address) && (
            <div class="side-card">
              <h2 class="h3">Contact details</h2>
              <ul class="details">
                {company.phone && (
                  <li>
                    <Icon name="phone" size={20} />
                    <a class="tabular" href={`tel:${tel}`}>{company.phone}</a>
                  </li>
                )}
                {company.email && (
                  <li>
                    <Icon name="mail" size={20} />
                    <a href={`mailto:${company.email}`}>{company.email}</a>
                  </li>
                )}
                {company.address && (
                  <li>
                    <Icon name="pin" size={20} />
                    <span>{company.address}</span>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  const done = document.querySelector<HTMLElement>('.form__done');
  const error = form?.querySelector<HTMLElement>('.form__error');

  // Pre-select the service from links such as /contact?topic=project-review
  const topics: Record<string, string> = {
    structural: 'Structural works',
    'project-management': 'Project management',
    'project-review': 'Project review',
    'site-visit': 'Site visit',
  };
  const topic = new URLSearchParams(location.search).get('topic');
  if (form && topic && topics[topic]) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="service"][value="${topics[topic]}"]`);
    if (radio) radio.checked = true;
  }

  const showError = (msg: string) => {
    if (!error) return;
    error.textContent = msg;
    error.hidden = false;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (error) error.hidden = true;
    if (!form.checkValidity()) {
      const first = form.querySelector<HTMLElement>(':invalid');
      showError('Please fill in the required fields: how we can help, your name, email and a few words about your project.');
      first?.focus();
      return;
    }
    const data = new FormData(form);
    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email;
    const button = form.querySelector<HTMLButtonElement>('.form__submit');

    if (!endpoint) {
      if (email) {
        const lines = ['service', 'name', 'phone', 'email', 'postcode', 'project_type', 'stage', 'message']
          .map((k) => `${k.replace('_', ' ')}: ${data.get(k) ?? ''}`)
          .join('\n');
        location.href = `mailto:${email}?subject=${encodeURIComponent('Project enquiry')}&body=${encodeURIComponent(lines)}`;
      } else {
        showError('Sorry, the enquiry form is not connected yet. Please try again later.');
      }
      return;
    }

    if (button) button.disabled = true;
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!res.ok || String(json.success) !== 'true') throw new Error(json.message);
      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.focus();
      }
    } catch {
      showError('Sorry, something went wrong sending your enquiry. Please try again in a moment.');
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .contact > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: 1.6fr 1fr;
      gap: 3rem;
    }
  }
  .form {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .form__row {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form__choice {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips label {
    position: relative;
  }
  .chips input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .chips span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--body);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .chips input:checked + span {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .chips input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .form__error {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-input);
    background: #fbeceb;
    color: #8a1f17;
    font-weight: 600;
  }
  .form__submit {
    justify-self: start;
  }
  .form__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .form__small {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .form__done {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0 0.5rem;
    color: var(--body);
  }
  .form__done :global(svg) {
    color: var(--copper);
  }
  .contact__side {
    display: grid;
    gap: 1rem;
  }
  .side-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: var(--radius-card);
    background: var(--stone);
    scroll-margin-top: 6rem;
  }
  .side-card > :global(svg) {
    color: var(--copper);
  }
  .side-card .btn {
    justify-self: start;
  }
  .side-note {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .details a,
  .details span {
    overflow-wrap: anywhere;
  }
  .details li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .details :global(svg) {
    color: var(--steel);
    flex: none;
  }
</style>
