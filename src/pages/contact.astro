---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { SITE_URL, company } from '../site';

const tel = company.phoneHref;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${company.name}`,
    url: `${SITE_URL}/contact`,
    about: { '@id': `${SITE_URL}/#business` },
  },
];
---

<Base
  title="Contact & Send Your Drawings | Brits Construction Projects"
  description="Request a structural works quotation, book a project review or send us your drawings. Tell us about your extension, loft conversion, alteration or new home."
  schema={schema}
>
  <PhotoHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]}
    image="/photos/stock-drawings.webp"
    alt="Site worker in hi-vis holding a roll of construction drawings"
    position="50% 50%"
    pill="Contact"
    title="Send us your drawings"
    accent="or arrange a discussion"
    lead="Tell us about your project and how we can help: structural works, project management, or both. We will come back to you to talk it through."
    caption="Bring your drawings"
  >
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#enquiry">
        Start your enquiry
        <span class="btn__chip"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="btn btn--outline" href={`tel:${tel}`}><Icon name="phone" size={20} /> {company.phone}</a>
    </div>
  </PhotoHero>

  <section class="section" aria-labelledby="form-heading">
    <div class="container contact">
      <div class="contact__form card">
        <h2 id="form-heading" class="h3 contact__h">Project enquiry</h2>
        <EnquiryForm id="enquiry" />
      </div>

      <div class="contact__side">
        <div class="side-card" id="drawings">
          <Icon name="drawing" size={28} />
          <h2 class="h3">Send us your drawings</h2>
          <p>
            Architectural drawings, the structural engineer’s design and your specification help us give you an accurate scope and quotation,
            or plan our oversight of your builder.
          </p>
          {
            company.email ? (
              <a class="btn btn--outline" href={`mailto:${company.email}?subject=${encodeURIComponent('Drawings for my project')}`}>
                <Icon name="mail" size={20} /> Email your drawings
              </a>
            ) : (
              <p class="side-note">Mention your drawings in the enquiry form and we will reply with the best way to send them.</p>
            )
          }
        </div>
        {
          (company.phone || company.email || company.address) && (
            <div class="side-card">
              <h2 class="h3">Contact details</h2>
              <ul class="details">
                {company.phone && (
                  <li>
                    <Icon name="phone" size={20} />
                    <a class="tabular" href={`tel:${tel}`}>{company.phone}</a>
                  </li>
                )}
                {company.email && (
                  <li>
                    <Icon name="mail" size={20} />
                    <a href={`mailto:${company.email}`}>{company.email}</a>
                  </li>
                )}
                {company.address && (
                  <li>
                    <Icon name="pin" size={20} />
                    <span>{company.address}</span>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>


<style>
  .contact {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .contact > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: 1.6fr 1fr;
      gap: 3rem;
    }
  }
  .contact__h {
    margin-bottom: 1.5rem;
  }
  .contact__side {
    display: grid;
    gap: 1rem;
  }
  .side-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: var(--radius-card);
    background: var(--stone);
    scroll-margin-top: 6rem;
  }
  .side-card > :global(svg) {
    color: var(--copper);
  }
  .side-card .btn {
    justify-self: start;
  }
  .side-note {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .details a,
  .details span {
    min-width: 0;
    font-size: clamp(0.85rem, 0.55rem + 1.6vw, 1rem);
  }
  /* Phone and email stay on one line; the address wraps. */
  .details a {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .side-card {
      padding: 1.25rem;
    }
  }
  .details a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .details li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
  }
  .details :global(svg) {
    color: var(--steel);
    flex: none;
  }
</style>
